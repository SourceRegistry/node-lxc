// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
  "name": "node-lxc",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Mount the host's Claude Code session data so conversations persist across rebuilds
  "mounts": [
    "source=${localEnv:USERPROFILE}/.claude,target=/root/.claude,type=bind,consistency=cached"
  ],

  // Install npm deps and build the native addon after the container is created
  "postCreateCommand": "npm install && npm run configure && npm run build:test",

  // Configure tool-specific properties.
  "customizations": {
    "jetbrains": {
      "backend": "CLion"
    }
  },
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "root",
  // Required for LXC: grants SYS_ADMIN and other capabilities needed to create kernel namespaces (CLONE_NEWNS, CLONE_NEWUTS, etc.)
  "runArgs": [
    "--privileged",
    "--security-opt", "apparmor=unconfined",
    "--security-opt", "seccomp=unconfined",
    "--tmpfs", "/run:exec,mode=755",
    "--tmpfs", "/run/lock"
  ]
}
