{
  "compilerOptions": {
    "target": "esnext",
    "sourceMap": true,
    "outDir": "./build/tsc",
    "strict": true,
    "lib": [
      "dom",
      "esnext"
    ],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "declaration": true,
    "module": "CommonJS",
    "noImplicitAny": false,
    "experimentalDecorators": true
  },
  "include": [
    "lib"
  ]
}

